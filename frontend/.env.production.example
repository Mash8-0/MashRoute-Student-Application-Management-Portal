# ─── MashRoute frontend — production ───────────────────────────
# Copy to `.env.production` and set to your LIVE domain before `npm run build`.
# If the backend is reverse-proxied under the SAME domain at /api (recommended),
# use your domain for both. Use https once SSL is set up.

VITE_API_URL=https://yourdomain.com/api/v1
VITE_SOCKET_URL=https://yourdomain.com
VITE_APP_NAME=MashRoute
VITE_APP_VERSION=1.0.0
