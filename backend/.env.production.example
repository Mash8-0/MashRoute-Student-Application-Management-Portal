# ─── MashRoute backend — production ────────────────────────────
# Copy to `.env` on the server and fill in real values. NEVER commit the real file.

NODE_ENV=production
PORT=3001
API_VERSION=v1

# ─── Database (Neon PostgreSQL) ───────────────────────────────
# Use your Neon connection string (keep ?sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ─── JWT (generate strong 64+ char secrets) ──────────────────
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHARS_MIN
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ─── Frontend origin(s) allowed by CORS + sockets ────────────
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Absolute base used for locally-stored file links (logos / verification docs)
# when Google Drive is unavailable. Set to your live API origin.
PUBLIC_API_URL=https://yourdomain.com

# ─── Google Drive (optional — falls back to local storage) ───
# If left blank or the token is expired, uploads are stored locally under /uploads.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ─── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# ─── File upload ─────────────────────────────────────────────
MAX_FILE_SIZE=15728640
UPLOAD_DIR=uploads

# ─── Super Admin seed (change before seeding!) ───────────────
SUPER_ADMIN_EMAIL=mashroute.store@gmail.com
SUPER_ADMIN_PASSWORD=M@shrur1308   # change after first login

# ─── WhatsApp (Meta Cloud API) — optional ────────────────────
# Leave blank to keep WhatsApp notifications off (no effect on the app).
# Use a PERMANENT System User token in production (the temporary one expires in 24h).
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_LANG=en_US
WHATSAPP_DEFAULT_COUNTRY_CODE=60
# Offer Letter Issued email attachment limit (default: 10 MB)
OFFER_LETTER_EMAIL_MAX_BYTES=10485760
# Optional comma-separated HTTPS storage hosts used only for secure email retries
OFFER_LETTER_STORAGE_HOSTS=
