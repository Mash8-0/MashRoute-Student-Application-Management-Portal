generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                       @id @default(uuid())
  name                  String
  slug                  String                       @unique
  domain                String?                      @unique
  logo                  String?
  email                 String                       @unique
  phone                 String?
  address               String?
  country               String?
  status                TenantStatus                 @default(PENDING)
  plan                  SubscriptionPlan             @default(STARTER)
  maxUsers              Int                          @default(10)
  maxStudents           Int                          @default(100)
  trialEndsAt           DateTime?
  subscriptionEndsAt    DateTime?
  settings              Json?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  deletedAt             DateTime?
  approvedAt            DateTime?
  approvedById          String?
  contactPersonEmail    String?
  contactPersonName     String?
  contactPersonPhone    String?
  createdSource         String?                      @default("self_signup")
  rejectionReason       String?
  submittedAt           DateTime?
  website               String?
  verificationDocName   String?
  verificationDocUrl    String?
  verificationType      String?
  whatsappConfig        Json?
  whatsappEnabled       Boolean                      @default(false)
  activityLogs          ActivityLog[]
  agents                Agent[]
  agentCommissions      AgentCommission[]
  applications          Application[]
  Intake                Intake[]
  IntakeAuditLog        IntakeAuditLog[]
  IntakeSetting         IntakeSetting?
  Invoice               Invoice[]
  InvoiceAuditLog       InvoiceAuditLog[]
  InvoiceRequest        InvoiceRequest[]
  InvoiceSequence       InvoiceSequence[]
  LateIntakeApproval    LateIntakeApproval[]
  notifications         Notification[]
  payments              Payment[]
  students              Student[]
  subscriptions         Subscription[]
  universities          University[]
  universityCommissions UniversityCommission[]
  commissionPolicies    UniversityCommissionPolicy[]
  users                 User[]
  assignedUniversities  University[]                 @relation("UniversityAssignments")

  @@index([slug])
  @@index([status])
}

model User {
  id                                                        String               @id @default(uuid())
  tenantId                                                  String?
  email                                                     String               @unique
  password                                                  String
  firstName                                                 String
  lastName                                                  String
  phone                                                     String?
  avatar                                                    String?
  role                                                      Role                 @default(STAFF)
  isActive                                                  Boolean              @default(true)
  isEmailVerified                                           Boolean              @default(false)
  emailVerifyToken                                          String?
  emailVerifyExpiry                                         DateTime?
  resetToken                                                String?
  resetTokenExpiry                                          DateTime?
  refreshToken                                              String?
  lastLoginAt                                               DateTime?
  createdAt                                                 DateTime             @default(now())
  updatedAt                                                 DateTime             @updatedAt
  deletedAt                                                 DateTime?
  agentCategory                                             String?              @default("STANDARD")
  activityLogs                                              ActivityLog[]
  assignedAgents                                            Agent[]              @relation("AgentAssignedStaff")
  createdAgents                                             Agent[]              @relation("AgentCreatedBy")
  linkedAgent                                               Agent?               @relation("AgentLinkedUser")
  approvedAgentCommissions                                  AgentCommission[]    @relation("AgentCommissionApprovedBy")
  createdAgentCommissions                                   AgentCommission[]    @relation("AgentCommissionCreatedBy")
  acceptedApplications                                      Application[]        @relation("AcceptedBy")
  assignedApplications                                      Application[]        @relation("AssignedAgent")
  createdApplications                                       Application[]        @relation("CreatedBy")
  uploadedEvisas                                            Application[]        @relation("EvisaUploadedBy")
  issuedInvoices                                            Application[]        @relation("InvoiceIssuedBy")
  Application_Application_mdacVerifiedByIdToUser            Application[]        @relation("Application_mdacVerifiedByIdToUser")
  uploadedOfferLetters                                      Application[]        @relation("OfferLetterUploadedBy")
  uploadedPaymentProofs                                     Application[]        @relation("PaymentProofUploadedBy")
  verifiedPayments                                          Application[]        @relation("PaymentVerifiedBy")
  uploadedTuitionProofs                                     Application[]        @relation("TuitionProofUploadedBy")
  verifiedTuitions                                          Application[]        @relation("TuitionVerifiedBy")
  notes                                                     ApplicationNote[]
  uploadedDocuments                                         Document[]           @relation("DocumentUploader")
  extractionLogs                                            ExtractionLog[]
  Intake_Intake_createdByIdToUser                           Intake[]             @relation("Intake_createdByIdToUser")
  Intake_Intake_updatedByIdToUser                           Intake[]             @relation("Intake_updatedByIdToUser")
  IntakeAuditLog                                            IntakeAuditLog[]
  Invoice                                                   Invoice[]
  generatedLOEs                                             LOE[]                @relation("LOEGeneratedBy")
  LateIntakeApproval_LateIntakeApproval_requestedByIdToUser LateIntakeApproval[] @relation("LateIntakeApproval_requestedByIdToUser")
  LateIntakeApproval_LateIntakeApproval_reviewedByIdToUser  LateIntakeApproval[] @relation("LateIntakeApproval_reviewedByIdToUser")
  notifications                                             Notification[]
  Payment_Payment_rejectedByUserIdToUser                    Payment[]            @relation("Payment_rejectedByUserIdToUser")
  Payment_Payment_submittedByUserIdToUser                   Payment[]            @relation("Payment_submittedByUserIdToUser")
  Payment_Payment_verifiedByUserIdToUser                    Payment[]            @relation("Payment_verifiedByUserIdToUser")
  statusHistory                                             StatusHistory[]
  assignedStudents                                          Student[]            @relation("StudentAssignedStaff")
  createdStudents                                           Student[]            @relation("StudentCreatedBy")
  sourceUpdatedStudents                                     Student[]            @relation("StudentSourceUpdatedBy")
  tenant                                                    Tenant?              @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([email])
  @@index([role])
}

model Student {
  id                       String             @id @default(uuid())
  tenantId                 String
  fullName                 String
  passportNumber           String?
  dateOfBirth              DateTime?
  gender                   Gender?
  nationality              String?
  phone                    String?
  email                    String?
  address                  String?
  city                     String?
  country                  String?
  sponsorName              String?
  sponsorContact           String?
  emergencyContact         String?
  emergencyPhone           String?
  sscGrade                 String?
  sscYear                  Int?
  sscInstitution           String?
  hscGrade                 String?
  hscYear                  Int?
  hscInstitution           String?
  diplomaGrade             String?
  diplomaYear              Int?
  diplomaInstitution       String?
  bachelorGrade            String?
  bachelorYear             Int?
  bachelorInstitution      String?
  mastersGrade             String?
  mastersYear              Int?
  mastersInstitution       String?
  gpa                      Decimal?           @db.Decimal(4, 2)
  hasIELTS                 Boolean            @default(false)
  ieltsScore               Decimal?           @db.Decimal(3, 1)
  ieltsExpiry              DateTime?
  hasPTE                   Boolean            @default(false)
  pteScore                 Int?
  pteExpiry                DateTime?
  hasMOI                   Boolean            @default(false)
  photo                    String?
  isActive                 Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  deletedAt                DateTime?
  driveFolderId            String?
  driveFolderName          String?
  whatsapp                 String?
  passportNumberNormalized String?
  createdById              String?
  sourceType               StudentSourceType?
  sourceAgentId            String?
  assignedStaffId          String?
  sourceUpdatedByUserId    String?
  sourceUpdatedAt          DateTime?
  agentCommissions         AgentCommission[]
  applications             Application[]
  documents                Document[]
  Invoice                  Invoice[]
  InvoiceRequest           InvoiceRequest[]
  payments                 Payment[]
  assignedStaff            User?              @relation("StudentAssignedStaff", fields: [assignedStaffId], references: [id])
  createdBy                User?              @relation("StudentCreatedBy", fields: [createdById], references: [id])
  sourceAgent              Agent?             @relation(fields: [sourceAgentId], references: [id])
  sourceUpdatedBy          User?              @relation("StudentSourceUpdatedBy", fields: [sourceUpdatedByUserId], references: [id])
  tenant                   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, passportNumberNormalized], name: "student_tenant_passport_normalized_unique", map: "student_tenant_passport_normalized_unique")
  @@index([tenantId])
  @@index([passportNumber])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, createdById])
  @@index([tenantId, sourceType])
  @@index([tenantId, sourceAgentId])
  @@index([tenantId, assignedStaffId])
  @@index([fullName])
}

model Agent {
  id                      String            @id @default(uuid())
  tenantId                String
  type                    AgentType
  displayName             String
  agencyName              String?
  contactPerson           String?
  email                   String?
  phone                   String?
  whatsapp                String?
  address                 String?
  notes                   String?
  status                  AgentStatus       @default(ACTIVE)
  linkedUserId            String?           @unique
  assignedInternalStaffId String?
  createdByUserId         String
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  archivedAt              DateTime?
  assignedInternalStaff   User?             @relation("AgentAssignedStaff", fields: [assignedInternalStaffId], references: [id])
  createdBy               User              @relation("AgentCreatedBy", fields: [createdByUserId], references: [id])
  linkedUser              User?             @relation("AgentLinkedUser", fields: [linkedUserId], references: [id])
  tenant                  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissions             AgentCommission[]
  students                Student[]

  @@index([tenantId, displayName])
  @@index([tenantId, type, status])
  @@index([tenantId, email])
  @@index([tenantId, linkedUserId])
}

model AgentCommission {
  id                   String                @id @default(uuid())
  tenantId             String
  studentId            String
  agentId              String
  universityId         String?
  applicationId        String?
  commissionType       AgentCommissionType
  currency             String                @default("MYR")
  grossCommission      Float                 @default(0)
  agentCommission      Float                 @default(0)
  tenantCommission     Float                 @default(0)
  bonusAmount          Float                 @default(0)
  eligibilityMilestone String?
  status               AgentCommissionStatus @default(NOT_ELIGIBLE)
  expectedPayoutDate   DateTime?
  paidAt               DateTime?
  paymentReference     String?
  paymentProofUrl      String?
  agentInvoiceUrl      String?
  internalNotes        String?
  createdByUserId      String
  approvedByUserId     String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  agent                Agent                 @relation(fields: [agentId], references: [id])
  application          Application?          @relation(fields: [applicationId], references: [id])
  approvedBy           User?                 @relation("AgentCommissionApprovedBy", fields: [approvedByUserId], references: [id])
  createdBy            User                  @relation("AgentCommissionCreatedBy", fields: [createdByUserId], references: [id])
  student              Student               @relation(fields: [studentId], references: [id])
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  university           University?           @relation(fields: [universityId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, agentId])
  @@index([studentId])
  @@index([applicationId])
}

model University {
  id                 String                       @id @default(uuid())
  tenantId           String?
  name               String
  country            String
  city               String?
  website            String?
  logo               String?
  isActive           Boolean                      @default(true)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  code               String?
  courses            Json?
  email              String?
  phone              String?
  intakes            Json?
  agentCommissions   AgentCommission[]
  applications       Application[]
  Intake             Intake[]
  tenant             Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissions        UniversityCommission[]
  commissionPolicies UniversityCommissionPolicy[]
  assignedTenants    Tenant[]                     @relation("UniversityAssignments")

  @@index([tenantId])
}

model UniversityCommissionPolicy {
  id             String     @id @default(uuid())
  tenantId       String
  universityId   String
  releaseTiming  String     @default("AFTER_REGISTRATION")
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  commissionType String?
  payoutMethod   String?
  payoutTime     String?
  specialBonus   String?
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  university     University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([tenantId, universityId])
  @@index([universityId])
}

model UniversityCommission {
  id           String     @id @default(uuid())
  tenantId     String
  universityId String
  category     String
  amount       Float      @default(0)
  type         String     @default("FIXED")
  currency     String     @default("MYR")
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  course       String     @default("")
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([tenantId, universityId, course, category])
  @@index([tenantId])
  @@index([universityId])
}

model Application {
  id                                      String               @id @default(uuid())
  tenantId                                String
  studentId                               String
  universityId                            String?
  agentId                                 String?
  createdById                             String?
  referenceNo                             String               @unique
  program                                 String?
  intake                                  String?
  intakeYear                              Int?
  country                                 String?
  status                                  ApplicationStatus    @default(DRAFT)
  priority                                Priority             @default(MEDIUM)
  progressPct                             Int                  @default(0)
  rejectionReason                         String?
  submittedAt                             DateTime?
  completedAt                             DateTime?
  createdAt                               DateTime             @default(now())
  updatedAt                               DateTime             @updatedAt
  deletedAt                               DateTime?
  acceptedAt                              DateTime?
  acceptedById                            String?
  emgsPercentage                          Int                  @default(0)
  invoiceIssuedAt                         DateTime?
  invoiceIssuedById                       String?
  isAccepted                              Boolean              @default(false)
  offerLetterUploadedAt                   DateTime?
  offerLetterUploadedById                 String?
  offerLetterUrl                          String?
  paymentProofUploadedAt                  DateTime?
  paymentProofUploadedById                String?
  paymentProofUrl                         String?
  paymentVerifiedAt                       DateTime?
  paymentVerifiedById                     String?
  emgsPaymentStatus                       EmgsPaymentStatus    @default(NOT_CONFIGURED)
  emgsSetupDecision                       String?
  emgsNotRequiredReason                   String?
  emgsNotRequiredNote                     String?
  emgsSetupDecidedAt                      DateTime?
  emgsSetupDecidedById                    String?
  arrivalDate                             DateTime?
  arrivalStatus                           String?
  flightTicketUrl                         String?
  tuitionInvoiceIssuedAt                  DateTime?
  tuitionInvoiceIssuedById                String?
  tuitionProofUploadedAt                  DateTime?
  tuitionProofUploadedById                String?
  tuitionProofUrl                         String?
  tuitionVerifiedAt                       DateTime?
  tuitionVerifiedById                     String?
  evisaUploadedAt                         DateTime?
  evisaUploadedById                       String?
  evisaUrl                                String?
  tuitionVerificationRemarks              String?
  tuitionVerificationStatus               String?              @default("NONE")
  flightDate                              DateTime?
  postEvalStatus                          String?
  emgsApprovalUploadedAt                  DateTime?
  emgsApprovalUploadedById                String?
  emgsApprovalUrl                         String?
  evalApprovalUploadedAt                  DateTime?
  evalApprovalUploadedById                String?
  evalApprovalUrl                         String?
  commissionStatus                        String?              @default("PENDING")
  commissionStatusAt                      DateTime?
  commissionAmount                        Float?
  commissionCategory                      String?
  commissionCourse                        String?
  commissionCurrency                      String?              @default("MYR")
  commissionType                          String?
  englishProficiency                      EnglishProficiency   @default(NONE)
  campus                                  String?
  campusId                                String?
  campusCode                              String?
  programmeId                             String?
  airline                                 String?
  arrivalTimezone                         String?              @default("Asia/Kuala_Lumpur")
  flightNumber                            String?
  lastPortOfEmbarkation                   String?
  malaysiaAccommodationAddress            String?
  malaysiaAccommodationCity               String?
  malaysiaAccommodationName               String?
  malaysiaAccommodationPostcode           String?
  malaysiaAccommodationState              String?
  malaysiaAccommodationType               String?
  mdacPreviousArrivalDate                 DateTime?
  mdacProofDocumentId                     String?
  mdacProofUrl                            String?
  mdacRequired                            Boolean              @default(true)
  mdacReviewNotes                         String?
  mdacStatus                              MdacStatus           @default(REQUIRED)
  mdacSubmittedAt                         DateTime?
  mdacVerifiedAt                          DateTime?
  mdacVerifiedById                        String?
  modeOfTravel                            String?
  intakeId                                String?
  legacyIntake                            String?
  agentCommissions                        AgentCommission[]
  acceptedBy                              User?                @relation("AcceptedBy", fields: [acceptedById], references: [id])
  agent                                   User?                @relation("AssignedAgent", fields: [agentId], references: [id])
  createdBy                               User?                @relation("CreatedBy", fields: [createdById], references: [id])
  evisaUploadedBy                         User?                @relation("EvisaUploadedBy", fields: [evisaUploadedById], references: [id])
  intakeRecord                            Intake?              @relation(fields: [intakeId], references: [id])
  invoiceIssuedBy                         User?                @relation("InvoiceIssuedBy", fields: [invoiceIssuedById], references: [id])
  User_Application_mdacVerifiedByIdToUser User?                @relation("Application_mdacVerifiedByIdToUser", fields: [mdacVerifiedById], references: [id])
  offerLetterUploadedBy                   User?                @relation("OfferLetterUploadedBy", fields: [offerLetterUploadedById], references: [id])
  paymentProofUploadedBy                  User?                @relation("PaymentProofUploadedBy", fields: [paymentProofUploadedById], references: [id])
  paymentVerifiedBy                       User?                @relation("PaymentVerifiedBy", fields: [paymentVerifiedById], references: [id])
  student                                 Student              @relation(fields: [studentId], references: [id])
  tenant                                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tuitionProofUploadedBy                  User?                @relation("TuitionProofUploadedBy", fields: [tuitionProofUploadedById], references: [id])
  tuitionVerifiedBy                       User?                @relation("TuitionVerifiedBy", fields: [tuitionVerifiedById], references: [id])
  university                              University?          @relation(fields: [universityId], references: [id])
  notes                                   ApplicationNote[]
  documents                               Document[]
  EmailLog                                EmailLog[]
  Invoice                                 Invoice[]
  InvoiceRequest                          InvoiceRequest[]
  loe                                     LOE?
  LateIntakeApproval                      LateIntakeApproval[]
  notifications                           Notification[]
  payments                                Payment[]
  statusHistory                           StatusHistory[]

  @@index([tenantId])
  @@index([studentId])
  @@index([agentId])
  @@index([status])
  @@index([referenceNo])
  @@index([intakeId])
  @@index([mdacVerifiedById])
  @@index([tenantId, arrivalDate])
  @@index([tenantId, mdacRequired])
  @@index([tenantId, mdacStatus, arrivalDate])
  @@index([tenantId, mdacStatus])
}

model Document {
  id                 String          @id @default(uuid())
  tenantId           String
  studentId          String
  applicationId      String?
  uploadedById       String?
  type               DocumentType
  status             DocumentStatus  @default(PENDING)
  originalName       String
  fileName           String
  fileUrl            String
  fileSize           Int?
  mimeType           String?
  publicId           String?
  expiryDate         DateTime?
  notes              String?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  driveFolderId      String?
  driveViewLink      String?
  fileSource         String?         @default("local")
  documentStage      String?
  rejectedReason     String?
  verificationStatus String?         @default("NONE")
  verifiedAt         DateTime?
  verifiedById       String?
  application        Application?    @relation(fields: [applicationId], references: [id])
  student            Student         @relation(fields: [studentId], references: [id])
  uploadedBy         User?           @relation("DocumentUploader", fields: [uploadedById], references: [id])
  extractionLogs     ExtractionLog[]
  Payment            Payment[]

  @@index([tenantId])
  @@index([studentId])
  @@index([applicationId])
  @@index([type])
}

model Payment {
  id                                   String           @id @default(uuid())
  tenantId                             String
  studentId                            String
  applicationId                        String?
  invoiceNo                            String?          @unique
  amount                               Decimal          @db.Decimal(12, 2)
  currency                             String           @default("MYR")
  status                               PaymentStatus    @default(PENDING)
  dueDate                              DateTime?
  paidAt                               DateTime?
  receiptUrl                           String?
  notes                                String?
  description                          String?
  createdAt                            DateTime         @default(now())
  updatedAt                            DateTime         @updatedAt
  paymentDate                          DateTime?
  paymentMethod                        String?
  paymentMode                          String?
  paymentType                          String?
  rejectedAt                           DateTime?
  rejectedByUserId                     String?
  rejectionReason                      String?
  slipDocumentId                       String?
  slipFileUrl                          String?
  submittedByRole                      String?
  submittedByUserId                    String?
  transactionReference                 String?
  verifiedAt                           DateTime?
  verifiedByUserId                     String?
  Invoice                              Invoice[]
  InvoiceRequest                       InvoiceRequest[]
  application                          Application?     @relation(fields: [applicationId], references: [id])
  User_Payment_rejectedByUserIdToUser  User?            @relation("Payment_rejectedByUserIdToUser", fields: [rejectedByUserId], references: [id])
  Document                             Document?        @relation(fields: [slipDocumentId], references: [id])
  student                              Student          @relation(fields: [studentId], references: [id])
  User_Payment_submittedByUserIdToUser User?            @relation("Payment_submittedByUserIdToUser", fields: [submittedByUserId], references: [id])
  tenant                               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User_Payment_verifiedByUserIdToUser  User?            @relation("Payment_verifiedByUserIdToUser", fields: [verifiedByUserId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([invoiceNo])
  @@index([applicationId])
  @@index([paymentType])
  @@index([submittedByUserId])
}

model PaymentDestinationAccount {
  id                  String                 @id @default(uuid())
  tenantId            String
  accountType         PaymentDestinationType
  universityId        String?
  label               String
  accountHolderName   String
  bankName            String
  accountNumber       String
  maskedAccountNumber String
  currency            String                 @default("MYR")
  branchName          String?
  swiftBic            String?
  iban                String?
  routingNumber       String?
  paymentInstructions String?
  qrCodeDocumentId    String?
  isDefault           Boolean                @default(false)
  isActive            Boolean                @default(true)
  createdByUserId     String
  updatedByUserId     String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  archivedAt          DateTime?

  @@index([tenantId, accountType, currency, isActive])
  @@index([tenantId, universityId, currency, isActive])
}

model ApplicationPaymentAccount {
  id            String            @id @default(uuid())
  tenantId      String
  studentId     String
  applicationId String            @unique
  status        EmgsPaymentStatus @default(NOT_CONFIGURED)
  currency      String            @default("MYR")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

model EmgsFeeItem {
  id                   String                 @id @default(uuid())
  tenantId             String
  studentId            String
  applicationId        String
  paymentAccountId     String
  feeType              String                 @default("EMGS")
  description          String
  amount               Decimal                @db.Decimal(12, 2)
  currency             String                 @default("MYR")
  dueDate              DateTime
  destinationType      PaymentDestinationType
  destinationAccountId String
  destinationSnapshot  Json
  allowPartialPayment  Boolean                @default(false)
  minimumPartialAmount Decimal?               @db.Decimal(12, 2)
  status               EmgsFeeStatus          @default(PAYMENT_PENDING)
  activeApplicationKey String?                @unique
  studentVisibleNote   String?
  internalNote         String?
  legacyPaymentId      String?
  invoiceId            String?
  createdByUserId      String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  cancelledAt          DateTime?

  @@index([tenantId, applicationId, status])
  @@index([paymentAccountId])
}

model EmgsPaymentTransaction {
  id                   String                 @id @default(uuid())
  tenantId             String
  studentId            String
  applicationId        String
  feeItemId            String
  amount               Decimal                @db.Decimal(12, 2)
  currency             String
  paymentDate          DateTime
  paymentMethod        String
  paidBy               String
  destinationType      PaymentDestinationType
  destinationAccountId String
  destinationSnapshot  Json
  transactionReference String?
  note                 String?
  proofDocumentId      String?
  proofFileUrl         String?
  proofHash            String?
  status               EmgsTransactionStatus  @default(PROOF_UPLOADED)
  submittedByUserId    String
  verifiedByUserId     String?
  verifiedAt           DateTime?
  rejectedByUserId     String?
  rejectedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([tenantId, applicationId, status])
  @@index([tenantId, transactionReference])
  @@index([tenantId, proofHash])
  @@index([feeItemId])
}

model EmgsPaymentAllocation {
  id            String   @id @default(uuid())
  tenantId      String
  transactionId String
  feeItemId     String
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  @@unique([transactionId, feeItemId])
  @@index([tenantId, feeItemId])
}

model EmgsPaymentReceipt {
  id                  String                 @id @default(uuid())
  tenantId            String
  studentId           String
  applicationId       String
  transactionId       String                 @unique
  receiptNo           String
  amount              Decimal                @db.Decimal(12, 2)
  currency            String
