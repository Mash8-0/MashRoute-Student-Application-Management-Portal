# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/mashroute_db?schema=public"

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_64_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_64_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ─── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
USE_LOCAL_STORAGE=true

# ─── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=MashRoute <noreply@mashroute.com>

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── File Upload ──────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# ─── OpenAI (future integration) ─────────────────────────────
OPENAI_API_KEY=

# ─── Anthropic Claude (future integration) ────────────────────
ANTHROPIC_API_KEY=

# ─── Super Admin (seed) ───────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@mashroute.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123!

# ─── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_LANG=en_US
WHATSAPP_DEFAULT_COUNTRY_CODE=60
# Offer Letter Issued email attachment limit (default: 10 MB)
OFFER_LETTER_EMAIL_MAX_BYTES=10485760
# Optional comma-separated HTTPS storage hosts used only for secure email retries
OFFER_LETTER_STORAGE_HOSTS=
PUBLIC_APP_URL=https://mashroute.com
OFFER_LETTER_STUDENT_LINK_HOURS=168
OFFER_LETTER_INTERNAL_LINK_HOURS=24
OFFER_LETTER_PREVIEW_MAX_BYTES=20971520
